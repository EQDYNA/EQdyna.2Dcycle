#! /usr/bin/env python3 

import xml.etree.ElementTree as ET
import shutil, sys, os

SKIP_DIRS = {'fem_mesh_output', '__pycache__', 'archive', 'aRawSimuData', 'aRawSimuData.preFix', 'aPlots'}
SKIP_FILES = {
    '.DS_Store',
    'run.sh',
    'FE_Global.txt',
    'FE_Model_Geometry.txt',
    'FE_Fault_Geometry.txt',
}

def case_copy(src, dst):
    # copy files and directories from src to dst, skipping generated dirs
    filenames = os.listdir(src)
    for f in filenames:
        if f in SKIP_DIRS:
            continue
        if f in SKIP_FILES:
            continue
        srcf = os.path.join(src, f)
        dstf = os.path.join(dst, f)

        if os.path.isdir(srcf):
            # Copy directory recursively
            shutil.copytree(srcf, dstf, dirs_exist_ok=True)
        else:
            # Copy file
            shutil.copy2(srcf, dst)

def _main_func(description):

    case_path = sys.argv[1]
    compset = sys.argv[2]
    print('Directory for newly created case is ', case_path)
    print('Compset chosen is ', compset)

    env_var = os.environ

    shutil.rmtree(str(case_path), ignore_errors=True)
    os.makedirs(str(case_path), exist_ok=True)
    
    eqdyna2dcycleRoot = env_var['EQDYNA2DCYCLEROOT']
    input_path = eqdyna2dcycleRoot + '/compset/' + str(compset) 
    utils_path = eqdyna2dcycleRoot + '/scripts'
    bin_path = eqdyna2dcycleRoot + '/bin'
  
    case_copy(input_path, case_path)
    case_copy(utils_path, case_path)
    case_copy(bin_path, case_path)

if __name__ == "__main__":
    _main_func(__doc__)
