#! /usr/bin/env python3
"""
Script to setup the case via user_defined_params.py.
"""
from user_defined_params import par
import numpy as np
import os

def create_model_input_file():
    # Function to create bGlobal.txt, bModelGeometry.txt, b.FaultGeometry.txt,
    #  bMaterial.txt, bStations.txt used by EQdyna.
    with open('FE_Global.txt', 'w') as f:
        f.write(str(par.C_mesh)        + "\n")
        f.write(str(par.ntotft)   + "\n")
        f.write(str(par.friclaw)    + "\n")
        f.write(" "           + "\n")
        f.write(str(par.dt1)     + "\n")
        f.write(str(par.term) + "\n")
        f.write(str(par.icstart)+" "+str(par.icend)+" "+"\n")
        f.write(" "           + "\n")
        f.write(str(par.fric_fs) + "\n")
        f.write(str(par.fric_fd) + "\n")
        f.write(str(par.fric_fv) + "\n")
        f.write(str(par.fric_fini) + "\n")
        f.write(str(par.critd0) + "\n")
        f.write(str(par.critv0) + "\n")
        f.write(str(par.critt0) + "\n")
        f.write(str(par.vrupt0) + "\n")
        f.write(str(par.radius) + "\n")
        f.write(" "           + "\n")
        f.write(str(par.vp) + "\n")
        f.write(str(par.vs) + "\n")
        f.write(str(par.rou) + "\n")
        f.write(str(par.eta0) + "\n")
        f.write(str(par.maxShearStrainLoadRate) + "\n")
        f.write(" "           + "\n")
        f.write(str(par.ambientnorm) + "\n")
        f.write(str(par.debug) + "\n")
        f.write(str(par.plotmesh) + "\n")
        
    with open('FE_Model_Geometry.txt', "w") as f:
        f.write(str(par.yext) + "\n")
        f.write(str(par.rat) + "\n")
        f.write(str(par.dxy) + "\n")
        
    with open('FE_Fault_Geometry.txt', "w") as f:
        for i in range(par.ntotft):
            f.write(str(par.ftcn[i])+"  ")
            
def create_run_sh():
    with open("run.sh", "w") as f:
        f.write("#! /bin/bash\n")
        f.write("echo 'Setting up simulation...'\n\n")

        if par.C_mesh == 2:
            # Internal Fortran meshing (2.0.2-style)
            # Required files come from compset: x*_1.txt, Rate_direction.txt
            required = ['FE_Global.txt', 'FE_Model_Geometry.txt', 'FE_Fault_Geometry.txt',
                        'Rate_direction.txt']
            for i in range(1, par.ntotft + 1):
                required.append('x' + str(i) + '_1.txt')
            f.write("REQUIRED_FILES=(" + " ".join("'" + r + "'" for r in required) + ")\n")
            f.write("for file in \"${REQUIRED_FILES[@]}\"; do\n")
            f.write("  if [ ! -f \"$file\" ]; then\n")
            f.write("    echo \"Error: Required file $file not found\"\n")
            f.write("    exit 1\n")
            f.write("  fi\n")
            f.write("done\n\n")
            f.write("echo 'All required files found. Submitting simulation to background...'\n\n")
            f.write("LOGFILE=\"run_$(date +%Y%m%d_%H%M%S).log\"\n")
            f.write("echo \"Logging to $LOGFILE\"\n")
            # setsid detaches the wrapper into its own session so a
            # process-group kill cannot orphan the binary and skip the
            # post-run steps. Not present on macOS, so fall back to plain
            # nohup there.
            f.write("SETSID=$(command -v setsid || true)\n")
            f.write("$SETSID nohup bash -c '\n")
            f.write("  export GFORTRAN_UNBUFFERED_ALL=1  # flush stdout in real time\n")
            f.write("  export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}  # OpenMP threads (default serial; set in caller env to scale up)\n")
            f.write("  echo \"=== Job started at $(date) ===\"\n")
            f.write("  mkdir -p aRawSimuData\n")
            f.write("  rm -f totalop.txt* cyclelog.txt* interval.txt*  # keep binaryop: it is the restart state\n")
            f.write("  ./" + par.exe + "\n")
            f.write("  plotRuptureDynamics\n")
            f.write("  mv totalop.txt* cyclelog.txt* interval.txt* binaryop aRawSimuData 2>/dev/null\n")
            f.write("  echo \"=== Job finished at $(date) ===\"\n")
            f.write("' > \"$LOGFILE\" 2>&1 &\n")
            f.write("echo \"Job PID: $!\"\n")
        else:
            # External gmsh-based meshing (C_mesh=3)
            # Re-meshing on every launch used to silently discard per-node
            # loading applied on top of the mesh: apply_strain_loading.py
            # patches nsmpGeoPhys.txt in place, then meshgen.py regenerated
            # it and the copy loop below overwrote the patched file with the
            # default. The run then went ahead with uniform default loading
            # and nothing said so. Skip meshing when a mesh is already there,
            # and never overwrite a working copy that is newer than its
            # fem_mesh_output source.
            mesh_files = ['vert.txt', 'fac.txt', 'nsmp.txt', 'nsmpGeoPhys.txt',
                          'meshGeneralInfo.txt', 'nsmpTanLen.txt']
            f.write("# Mesh generation. meshgen.py is SKIPPED when a mesh already exists:\n")
            f.write("# re-meshing would discard per-node edits made on top of it (e.g.\n")
            f.write("# nsmpGeoPhys.txt patched by apply_strain_loading.py). Set FORCE_MESH=1\n")
            f.write("# to re-mesh deliberately.\n")
            f.write("MESH_STAMP='fem_mesh_output/meshGeneralInfo.txt'\n")
            f.write("if [ -n \"$FORCE_MESH\" ] || [ ! -f \"$MESH_STAMP\" ]; then\n")
            f.write("  echo 'Running meshgen.py...'\n")
            f.write("  python3 meshgen.py\n")
            f.write("else\n")
            f.write("  echo \"Mesh present ($MESH_STAMP); skipping meshgen.py.\"\n")
            f.write("  echo 'Set FORCE_MESH=1 to re-mesh from scratch.'\n")
            f.write("fi\n\n")
            f.write("# Stage mesh files into the case directory. A working copy NEWER than\n")
            f.write("# its fem_mesh_output source was edited on purpose -- keep it.\n")
            f.write("if [ -d 'fem_mesh_output' ]; then\n")
            f.write("  for mf in " + " ".join(mesh_files) + "; do\n")
            f.write("    src=\"fem_mesh_output/$mf\"\n")
            f.write("    if [ ! -f \"$src\" ]; then echo \"Warning: $mf not found\"; continue; fi\n")
            f.write("    if [ -f \"$mf\" ] && [ \"$mf\" -nt \"$src\" ]; then\n")
            f.write("      echo \"Keeping local $mf (newer than $src -- not overwriting)\"\n")
            f.write("    else\n")
            f.write("      cp \"$src\" \"$mf\"\n")
            f.write("    fi\n")
            f.write("  done\n")
            f.write("fi\n\n")
            required = ['vert.txt', 'fac.txt', 'nsmp.txt', 'nsmpGeoPhys.txt',
                        'meshGeneralInfo.txt', 'FE_Global.txt', 'FE_Model_Geometry.txt', 'FE_Fault_Geometry.txt']
            f.write("REQUIRED_FILES=(" + " ".join("'" + r + "'" for r in required) + ")\n")
            f.write("for file in \"${REQUIRED_FILES[@]}\"; do\n")
            f.write("  if [ ! -f \"$file\" ]; then\n")
            f.write("    echo \"Error: Required file $file not found\"\n")
            f.write("    echo \"Make sure to run 'python3 meshgen.py' first\"\n")
            f.write("    exit 1\n")
            f.write("  fi\n")
            f.write("done\n\n")
            f.write("echo 'All required files found. Submitting simulation to background...'\n\n")
            f.write("LOGFILE=\"run_$(date +%Y%m%d_%H%M%S).log\"\n")
            f.write("echo \"Logging to $LOGFILE\"\n")
            # setsid detaches the wrapper into its own session so a
            # process-group kill cannot orphan the binary and skip the
            # post-run steps. Not present on macOS, so fall back to plain
            # nohup there.
            f.write("SETSID=$(command -v setsid || true)\n")
            f.write("$SETSID nohup bash -c '\n")
            f.write("  export GFORTRAN_UNBUFFERED_ALL=1  # flush stdout in real time\n")
            f.write("  export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}  # OpenMP threads (default serial; set in caller env to scale up)\n")
            f.write("  echo \"=== Job started at $(date) ===\"\n")
            f.write("  mkdir -p aRawSimuData\n")
            f.write("  rm -f totalop.txt* cyclelog.txt* interval.txt*\n")
            f.write("  ./" + par.exe + "\n")
            f.write("  plotRuptureDynamics\n")
            f.write("  mv totalop.txt* cyclelog.txt* interval.txt* aRawSimuData 2>/dev/null\n")
            f.write("  echo \"=== Job finished at $(date) ===\"\n")
            f.write("' > \"$LOGFILE\" 2>&1 &\n")
            f.write("echo \"Job PID: $!\"\n")

def _main_func(description):
    create_model_input_file()
    create_run_sh()

if __name__ == "__main__":
    _main_func(__doc__)
